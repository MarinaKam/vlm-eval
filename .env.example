# Copy to .env and fill in. .env is gitignored — machine/company-specific values live only here.

# Path to the Django app you export the evaluation dataset from (its .venv and .env are reused)
VLM_EVAL_SOURCE_REPO=~/PycharmProjects/your-django-app

# Optional overrides (defaults: ./data, ./runs, ./reports inside this repo)
#VLM_EVAL_DATA_DIR=
#VLM_EVAL_RUNS_DIR=
#VLM_EVAL_REPORT_DIR=

# Dataset export tunables (optional)
#VLM_EVAL_DAYS_BACK=180
#VLM_EVAL_INDOOR=650
#VLM_EVAL_OUTDOOR=350
#VLM_EVAL_PROPERTIES=5

# Management command in your app that measures API token cost (used by `vlm-eval cost`)
#VLM_EVAL_COST_COMMAND=measure_gemini_image_cost

# HF token — only needed for gated checkpoints (e.g. google/paligemma2-*)
#HF_TOKEN=
